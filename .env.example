# Variáveis públicas (VITE_*) — valores padrão para desenvolvimento e build de demonstração.
# Ativa a camada de mocks MSW (REST + Socket.IO). Em "false" o app fala com um backend real.
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks (veja README → Cenários). Pode ser trocado em runtime por ?scenario=...
VITE_MOCK_SCENARIO=default
# Exibe o painel flutuante de controle dos mocks e expõe window.__mocks (usado pelos testes E2E).
VITE_MOCK_CONTROLS=true
# Base da API REST (relativa ao domínio ou absoluta).
VITE_API_BASE_URL=/api
# URL do servidor Socket.IO (vazio = mesma origem).
VITE_SOCKET_URL=
# Timeout das requisições HTTP em ms.
VITE_API_TIMEOUT_MS=10000
